{
  "$comment": "Config agent decompilazione automatica. flag_sets: la flag-sweep prova ogni voce (anche stringa vuota).",
  "backend": "heuristic",
  "max_iters": 3,
  "max_variants_per_unit": 8,
  "compile_timeout": 300,
  "compile_c": "docker run --rm -v {root}:/workspace amiga-decomp-toolchain vc +aos68k -c -Iinclude {flags} {src} -o {out}",
  "compile_asm": "docker run --rm -v {root}:/workspace amiga-decomp-toolchain vasmm68k_mot -Fhunk -m68000 -Iinclude {src} -o {out}",
  "flag_sets": ["", "-O1", "-O2"],
  "llm": {
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4o-mini",
    "api_key_env": "OPENAI_API_KEY",
    "max_proposals": 2
  }
}
